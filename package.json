{
	"name": "bonkers-ui",
	"version": "2.0.0",
	"type": "module",
	"description": "Bonkers ui library",
	"author": "cc6.magister@gmail.com",
	"scripts": {
		"dev": "storybook dev -p 6006",
		"deploy": "gh-pages -d storybook-static",
		"lint": "eslint --fix './src/**/*.{ts,tsx}'",
		"lint:style": "bun run prettier './src/**/*.{css,scss}' --check",
		"upgrade": "bun update --interactive",
		"build-storybook": "storybook build",
		"build": "tsc -p tsconfig.app.json && vite build",
		"typecheck": "tsc -p tsconfig.app.json --noEmit",
		"i": "bun install --frozen-lockfile",
		"pack": "bun run build && bun run postbuild.ts && cd dist && npm pack --pack-destination ../",
		"prepare": "husky"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.3.1",
		"@eslint-react/eslint-plugin": "^5.20.6",
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-brands-svg-icons": "^7.3.1",
		"@fortawesome/free-regular-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@fortawesome/react-fontawesome": "^3.5.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-onboarding": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"ajv": "^8.20.0",
		"classnames": "^2.5.1",
		"eslint": "^10.11.0",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-storybook": "^10.6.0",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"gh-pages": "^6.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"postcss": "^8.5.28",
		"prettier": "^3.9.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"storybook": "^10.6.0",
		"stylelint": "^17.15.0",
		"stylelint-config-tailwindcss": "^1.0.1",
		"stylelint-prettier": "^5.0.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vite-plugin-dts": "^5.1.1",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vite-tsconfig-paths": "^6.1.1"
	},
	"peerDependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-brands-svg-icons": "^7.3.1",
		"@fortawesome/free-regular-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@fortawesome/react-fontawesome": "^3.5.0",
		"classnames": "^2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3"
	},
	"lint-staged": {
		"./src/**/*.css": [
			"bun prettier --check"
		],
		"./src/**/*.{ts,tsx}": [
			"bun eslint --fix",
			"bash -c 'bun typecheck'"
		]
	},
	"keywords": [],
	"license": "ISC",
	"main": "./index.js",
	"module": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": "./index.js",
		"./types/*": {
			"import": "./_types/*.js",
			"types": "./_types/*.d.ts*"
		},
		"./theme": "./bonkers.css",
		"./*": {
			"types": "./components/*/index.d.ts",
			"import": "./components/*/index.js"
		},
		"./components/*": {
			"types": "./components/*",
			"import": "./components/*"
		},
		"./eslint.config.mjs": "./eslint.config.mjs"
	},
	"sideEffects": [
		"*.css",
		"./assets/*.css"
	]
}
